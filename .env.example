HOST=127.0.0.1
PORT=4317
APP_ORIGIN=http://localhost:4317
DATA_DIR=./data
# HTTPS is required outside localhost. Set SECURE_COOKIE=true behind HTTPS.
SECURE_COOKIE=false
RP_ID=localhost
# Server-only provisioning account; never committed. First login uses email OTP.
BOOTSTRAP_ADMIN_EMAIL=
# Optional initial password: admin can subsequently provision passwords for members.
BOOTSTRAP_ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTION_TOKEN=
NOTION_WORKSHOPS_SOURCE=
NOTION_POLL_SECONDS=30
# Approval registry is provisioned by the operator, NOT from client settings.
# JSON array of {id,label,endpoint,keyEnv,capabilities,approvalReference}
# Gateway contract: docs/AI-GATEWAY.md. Genspark public API is not assumed.
AI_APPROVED_PROVIDERS=[]
