{
  "name": "workshop-idea-deck",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "build": { "command": "node scripts/build-cloudflare.js" },
  "assets": {
    "directory": ".cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "APP_STATE", "class_name": "WorkshopState" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkshopState"] }],
  "rules": [{ "type": "Text", "globs": ["**/ai-facilitator.md"], "fallthrough": false }],
  "observability": { "enabled": true },
}
